# Copy to .env and adjust. Compose reads .env automatically.
# Never commit the real .env — it is excluded from git and from the image.

# --- Postgres (the bundled Compose service) -----------------------------------------------
POSTGRES_USER=nightwatch
POSTGRES_DB=nightwatch
# Change this before exposing the stack anywhere.
POSTGRES_PASSWORD=change-me

# Compose derives the connection string from the three values above, so changing the password
# is enough. Uncomment only to bring your own Postgres instead of the bundled service.
# DATABASE_URL=postgres://user:password@your-host:5432/nightwatch
#
# For host-side development put the localhost variant in .env.local instead of here — Bun reads
# it and Compose does not, so the containers keep talking to the `postgres` service:
#   DATABASE_URL=postgres://nightwatch:change-me@localhost:5432/nightwatch

# Publish Postgres on the host so host-side development can reach it. Loopback only — drop the
# published port entirely in production, nothing outside the Compose network needs it.
POSTGRES_PORT=5432

# --- Web ----------------------------------------------------------------------------------
# Host port the dashboard is published on.
WEB_PORT=3000
# Public origin of the dashboard. SvelteKit needs it for form actions and CSRF checks; set it
# to the URL your reverse proxy serves (TLS is terminated there — SPEC §12).
ORIGIN=http://localhost:3000

# --- Image ---------------------------------------------------------------------------------
# Published Compose files pin the minor version; `latest` is fine while developing.
NIGHTWATCH_VERSION=latest

# --- Secrets ---------------------------------------------------------------------------------
# Encrypts the credentials Nightwatch stores in Postgres (Graph client secret, and later Autotask
# and webhook secrets) with AES-256-GCM. 32 bytes, base64 or hex:
#
#   openssl rand -base64 32
#
# Required before you can connect a mailbox — the stack boots without it. Keep it out of version
# control; losing it means re-entering the credentials, nothing else.
NIGHTWATCH_SECRET_KEY=

# --- Timing ---------------------------------------------------------------------------------
# How often each service writes its heartbeat. A service counts as stale after four missed ones.
HEARTBEAT_INTERVAL_SECONDS=15
# How long a main loop may go silent before the process kills itself and Docker restarts it.
WATCHDOG_TIMEOUT_SECONDS=90
# How often the worker looks for mailboxes whose poll is due. Not the poll interval itself — that
# is configured per mailbox (60–300 s) in the settings.
INGESTION_TICK_SECONDS=15

# debug | info | warn | error
LOG_LEVEL=info
